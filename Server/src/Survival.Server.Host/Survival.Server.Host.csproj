<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>orol-server</AssemblyName>
    <RootNamespace>Survival.Server.Host</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Survival.Shared/Survival.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../deploy/server.json" Link="server.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
