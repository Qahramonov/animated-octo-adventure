# systemd unit for running the published server without Docker.
#   sudo useradd --system --home /opt/orol orol
#   sudo mkdir -p /opt/orol && sudo cp -r out/* /opt/orol/ && sudo chown -R orol /opt/orol
#   sudo cp orol-server.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now orol-server && journalctl -u orol-server -f
[Unit]
Description=OROL Survival dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orol
WorkingDirectory=/opt/orol
ExecStart=/opt/orol/orol-server --no-console --config /opt/orol/server.json --dataDirectory /opt/orol/data
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
